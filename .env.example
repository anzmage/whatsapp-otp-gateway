# Generate a unique token: openssl rand -hex 32
# Required for first-owner registration. Never commit your real .env.
SETUP_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Use your exact public HTTPS origin behind a reverse proxy.
# HTTP is allowed only for localhost / 127.0.0.1 development.
PUBLIC_URL=http://localhost:3000
PORT=3000
HOST=0.0.0.0
DATA_DIR=.data

# Default: ignore X-Forwarded-* headers.
# Set to loopback ONLY when a trusted reverse proxy connects from loopback.
# Docker proxies on other networks are not automatically trusted.
TRUST_PROXY=false

MAX_DEVICES=5
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=60
OTP_APP_PER_MINUTE=10
OTP_APP_PER_DAY=100
OTP_RECIPIENT_PER_HOUR=5
OTP_IP_PER_MINUTE=20
OTP_DEVICE_PER_MINUTE=10
